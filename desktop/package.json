{
  "name": "boardly-desktop",
  "productName": "Marsam",
  "version": "1.0.0",
  "description": "Marsam — Tactile Project Management Desktop App",
  "author": "Mohamed Ali Shaltout",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.cjs",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.boardly.desktop",
    "productName": "Marsam",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.*",
      "!dist",
      "!scripts"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "app",
        "filter": [
          "index.html",
          "css/**/*",
          "js/**/*",
          "assets/**/*",
          "!desktop/**/*",
          "!node_modules/**/*",
          "!tests/**/*",
          "!*.log",
          "!server.js"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Marsam",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
